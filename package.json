{
  "name": "posture-sentinel",
  "version": "0.1.0",
  "private": true,
  "description": "隐私优先的本地坐姿监测应用",
  "author": "Posture Sentinel",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "desktop:dev": "node electron/dev.cjs",
    "desktop:prepare": "node electron/prepare-next.cjs",
    "desktop:pack": "bun run build && bun run desktop:prepare && electron-builder --mac dmg -c.electronDist=node_modules/electron/dist",
    "desktop:pack:dir": "bun run build && bun run desktop:prepare && electron-builder --mac dir",
    "start": "next start",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.35",
    "html2canvas": "^1.4.1",
    "next": "16.2.9",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^44.4.4",
    "electron-builder": "^26.15.3",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "build": {
    "appId": "com.posturesentinel.app",
    "productName": "Posture Sentinel",
    "asar": true,
    "files": [
      "electron/main.cjs",
      "electron/preload.cjs",
      "electron/baseline-store.cjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "next"
      }
    ],
    "directories": {
      "output": "dist-electron"
    },
    "mac": {
      "category": "public.app-category.healthcare-fitness",
      "icon": "electron/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "extendInfo": {
        "NSCameraUsageDescription": "Posture Sentinel 使用摄像头在本机分析坐姿，画面不会被录制或上传。"
      }
    },
    "dmg": {
      "title": "Posture Sentinel ${version}",
      "contents": [
        {
          "x": 140,
          "y": 220
        },
        {
          "x": 400,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  },
  "productName": "Posture Sentinel"
}
